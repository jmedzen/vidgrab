# 複製成 .env（docker compose 會自動讀）：cp .env.example .env
# .env 已在 .gitignore 與 .dockerignore 裡，不要提交真正的金鑰。

# ---- 認證 ----
# 設了就啟用 Bearer 認證。建議：openssl rand -hex 24
# 給 vidpipe 用的話，同一個值也要給 vidpipe 的 VIDPIPE_VIDGRAB_TOKEN
VIDGRAB_API_TOKEN=
# 沒設 token 時，容器綁 0.0.0.0 要這個才肯啟動（port 只對 127.0.0.1 發佈所以安全）。
# 設了 VIDGRAB_API_TOKEN 就請改成 0。
VIDGRAB_NO_AUTH=1
# 沒設 token、又想用網域名稱（例如 http://nas.local:8310）開網頁時，把主機名列在這裡（逗號分隔）。
# 用 IP 位址開（http://192.168.2.7:8310）不用設。
VIDGRAB_ALLOWED_HOSTS=

# ---- 素材站金鑰（沒填的來源會自己略過）----
# Pixabay（主力）：https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Jamendo client id（背景音樂）：https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=
# Pexels：目前暫停新的 API key 申請，有舊 key 才填
PEXELS_API_KEY=

# ---- 發佈 ----
# 只對本機發佈。要讓別台機器連，改成 0.0.0.0 並務必設 VIDGRAB_API_TOKEN
VIDGRAB_BIND=127.0.0.1
VIDGRAB_PUBLISH_PORT=8310
