#!/usr/bin/env bash
# vidgrab 啟動器：第一次執行會自己建 venv、裝 yt-dlp，之後直接跑。
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export VIDGRAB_HOME="${VIDGRAB_HOME:-$HERE/projects}"
export PYTHONPATH="$HERE/src${PYTHONPATH:+:$PYTHONPATH}"
# 所有快取都留在專案內，避免動到 ~/.cache
export UV_CACHE_DIR="${UV_CACHE_DIR:-$HERE/.cache/uv}"
export UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$HERE/.cache/python}"
export UV_TOOL_DIR="${UV_TOOL_DIR:-$HERE/.cache/uv-tools}"

VENV="$HERE/.venv"

# ffmpeg 只有真的要處理影片時才需要。
# build／list／vault 這類純讀取的指令不該被它擋住（CI 就是這樣掛的）。
# 清單只有一份（models.NEEDS_NO_FFMPEG），這裡不重複維護，
# 免得兩邊不同步——之前就是這樣讓 CI 掛掉。
needs_ffmpeg=1
_first_cmd=""
for _a in "$@"; do
  case "$_a" in
    -*) continue ;;
    *) _first_cmd="$_a"; break ;;
  esac
done
if [ -n "$_first_cmd" ]; then
  case " build list vault find config show login logout purge prune forget scrub test web " in
    *" $_first_cmd "*) needs_ffmpeg=0 ;;
  esac
fi
if [ "$needs_ffmpeg" = "1" ] && { ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; }; then
  echo "✗ 找不到 ffmpeg／ffprobe，這個指令需要它來處理影片。" >&2
  echo "  macOS：brew install ffmpeg" >&2
  echo "  Ubuntu：sudo apt-get install -y ffmpeg" >&2
  exit 1
fi

need_install=0
if [ ! -x "$VENV/bin/python" ]; then
  need_install=1
elif ! "$VENV/bin/python" -c "import yt_dlp" >/dev/null 2>&1; then
  need_install=1
fi

if [ "$need_install" = "1" ]; then
  if ! command -v uv >/dev/null 2>&1; then
    echo "✗ 找不到 uv。請先安裝：brew install uv" >&2
    exit 1
  fi
  echo "▶ 第一次執行：建立 venv 並安裝依賴（約 1 分鐘）…" >&2
  PY="$(command -v python3)"
  rm -rf "$VENV"
  uv venv --python "$PY" "$VENV" >&2
  # 依賴只在 pyproject.toml 宣告一次，這裡直接照著裝
  uv pip install --python "$VENV/bin/python" -e "$HERE" >&2
  echo "✔ 環境就緒" >&2
fi

exec "$VENV/bin/python" -m vidgrab "$@"
